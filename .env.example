# --- Telegram storage (required for uploads/serving) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_STORAGE_CHAT_ID=

# --- Sessions (required in production; generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))") ---
SESSION_SECRET=

# --- Database ---
# Local dev: SQLite (DB_PATH optional, default telebox.db)
DB_PATH=telebox.db
# Production (Vercel): set to a Postgres/Neon connection string. When set,
# the app uses Postgres instead of SQLite and ignores DB_PATH.
DATABASE_URL=

# --- Rate limiting (optional; falls back to in-memory locally) ---
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
